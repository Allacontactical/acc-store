{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allacontactical-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "vars": {
    "TELEGRAM_BOT_USERNAME": "Allacontactical_bot"
  },
  "assets": {
    "directory": "./worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "acc-catalog-db",
    "database_id": "506eb009-1462-4ff6-a781-1404e9aecf59"
  }]
}