{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allacontactical-bot-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "vars": {
    "TELEGRAM_BOT_USERNAME": "AllaconTacticalTest_bot"
  },
  "assets": {
    "directory": "./test-site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acc-test-db",
      "database_id": "8782a6cf-723a-4585-a917-7e68c12cd767"
    }
  ]
}
