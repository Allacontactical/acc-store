{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acc-catalog-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "../admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acc-catalog-db",
      "database_id": "506eb009-1462-4ff6-a781-1404e9aecf59"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "acc-product-images"
    }
  ],
  "vars": {
    "CATALOG_SOURCE_URL": "https://raw.githubusercontent.com/Allacontactical/acc-store/main/products.json"
  }
}