{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allacontactical-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "../admin",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acc-catalog",
      "database_id": "REPLACE_AFTER_CREATING_D1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "acc-product-media"
    }
  ],
  "vars": {
    "CATALOG_SOURCE_URL": "https://raw.githubusercontent.com/Allacontactical/acc-store/main/products.json"
  }
}